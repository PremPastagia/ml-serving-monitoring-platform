# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# MLflow tracking store and artefacts -- regenerated by `make train`
mlruns/
mlflow.db
artifacts/

# Raw data -- regenerated and checksum-verified by `python scripts/fetch_data.py`.
# Not committed (6 MB), but exactly reproducible: the SHA-256 of both files is pinned
# in src/mlserve/data/ingest.py and verified on every load.
data/raw/*
!data/raw/.gitkeep
data/processed/
data/scenarios/

# Server logs from benchmark runs -- noise, not evidence
results/**/*.log

# macOS
.DS_Store
